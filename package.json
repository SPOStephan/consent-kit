{
  "name": "consent-kit",
  "version": "0.2.0",
  "description": "Headless Consent-Management f\u00fcr Vite/React-Websites: Google Tag Manager mit Consent Mode v2, Meta Pixel, TikTok Pixel, Embeds \u2013 Skripte laden erst nach Einwilligung.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./ui": {
      "import": {
        "types": "./dist/ui.d.ts",
        "default": "./dist/ui.js"
      },
      "require": {
        "types": "./dist/ui.d.cts",
        "default": "./dist/ui.cjs"
      }
    },
    "./ui.css": "./dist/ui.css",
    "./table": {
      "import": {
        "types": "./dist/table.d.ts",
        "default": "./dist/table.js"
      },
      "require": {
        "types": "./dist/table.d.cts",
        "default": "./dist/table.cjs"
      }
    },
    "./remote": {
      "import": {
        "types": "./dist/remote.d.ts",
        "default": "./dist/remote.js"
      },
      "require": {
        "types": "./dist/remote.d.cts",
        "default": "./dist/remote.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "consent-kit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e && npm run size",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "playwright": ">=1.40",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.1",
    "playwright-core": "^1.56.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SPOStephan/consent-kit.git"
  },
  "homepage": "https://github.com/SPOStephan/consent-kit#readme",
  "keywords": [
    "consent",
    "cookie-banner",
    "gdpr",
    "dsgvo",
    "tdddg",
    "consent-mode",
    "google-tag-manager",
    "meta-pixel",
    "tiktok-pixel",
    "react",
    "vite"
  ]
}
